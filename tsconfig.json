{
    "files": ["src/index.ts"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "paths": {
            "./@matatbread/ai-ui/esm/ai-ui.js": ["./node_modules/@matatbread/ai-ui/esm/ai-ui.d.ts"]
        },
        "outDir": "dist",
        "noImplicitAny": true,
        "strict": true,
        "esModuleInterop": true,
        "lib": ["ES2021","DOM"],
        "module": "commonjs",
        "target": "ES2021",
        "allowJs": true,
        "checkJs": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "sourceMap": true
    }
}